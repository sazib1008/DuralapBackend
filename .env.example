# Duralap Docker Environment
# Copy this file to .env and adjust values as needed.
# Used automatically by docker-compose when .env exists in the project root.

# MongoDB (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?appName=Cluster0

# JWT (min 64 characters recommended for HS512)
JWT_SECRET=your-super-secret-jwt-key-min-64-characters-long-for-security

# Optional: override Redis/Kafka when not using bundled Docker infra
# SPRING_DATA_REDIS_URL=redis://redis:6379
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092
