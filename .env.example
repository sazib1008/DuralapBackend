# ==============================================================================
# Duralap Modular Monolith — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local or production environment:
#   cp .env.example .env
#
# Both local execution (via ./run.sh --local or ./gradlew) and Docker Compose
# will automatically load variables from the root .env file.
# ==============================================================================

# Application Server Port
PORT=8080

# ------------------------------------------------------------------------------
# Database: MongoDB Configuration
# ------------------------------------------------------------------------------
# MongoDB Atlas Cloud URI format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<appName>
# Local MongoDB URI format:
# MONGODB_URI=mongodb://localhost:27017/duralap
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/duralap?appName=Cluster0

# ------------------------------------------------------------------------------
# Cache & Pub/Sub: Redis Configuration
# ------------------------------------------------------------------------------
# Option A: Cloud / Remote Redis (SSL Enabled - e.g. Upstash):
# REDIS_URL=rediss://default:<password>@<host>:6379
# REDIS_SSL_ENABLED=true
#
# Option B: Local Redis without Docker (e.g., brew services start redis):
# REDIS_URL=redis://localhost:6379
# REDIS_SSL_ENABLED=false
#
# Option C: Docker Compose Redis:
# REDIS_URL=redis://redis:6379
# REDIS_SSL_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_SSL_ENABLED=false

# ------------------------------------------------------------------------------
# Object Storage: Supabase Storage (Optional)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_BUCKET=media
SUPABASE_API_KEY=your-supabase-anon-or-service-key

# ------------------------------------------------------------------------------
# WebRTC / Calling: TURN Server Configuration (Optional)
# ------------------------------------------------------------------------------
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# Security: JWT Configuration (HS512 Key - minimum 64 characters)
# ------------------------------------------------------------------------------
JWT_SECRET=your-minimum-64-character-hs512-secret-key-goes-here-0123456789
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
