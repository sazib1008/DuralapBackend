# Duralap Modular Monolith Environment Configuration
# Copy this file to .env and adjust values as needed.
# Both local (without Docker) and Docker modes will read this file automatically.

# Application Server Port
PORT=8080

# ------------------------------------------------------------------------------
# Database: MongoDB Configuration
# ------------------------------------------------------------------------------
# Option A: MongoDB Atlas Cloud (Default)
MONGODB_URI=mongodb+srv://sazib1008:VIlessaUR74ymfKG@cluster0.lsfwn33.mongodb.net/?appName=Cluster0
# Option B: Local MongoDB (without Docker or standalone)
# MONGODB_URI=mongodb://localhost:27017/duralap

# ------------------------------------------------------------------------------
# Cache & Pub/Sub: Redis Configuration
# ------------------------------------------------------------------------------
# Option A: Upstash Cloud Redis (SSL Enabled - Default for local development without Docker)
REDIS_URL=rediss://default:gQAAAAAAAm5xAAIgcDJlYzM0MTg5OTc5ZWE0MWVhOGQ3YTAyNDA1NjcxNmUwYw@glad-quail-159345.upstash.io:6379
REDIS_SSL_ENABLED=true

# Option B: Local Redis without Docker (e.g., brew services start redis on macOS)
# REDIS_URL=redis://localhost:6379
# REDIS_SSL_ENABLED=false

# Option C: Docker Compose Redis (automatically used when running in Docker)
# REDIS_URL=redis://redis:6379
# REDIS_SSL_ENABLED=false

# ------------------------------------------------------------------------------
# Object Storage: Supabase Storage
# ------------------------------------------------------------------------------
SUPABASE_URL=https://ussecjukilmnfbvozjxq.supabase.co
SUPABASE_BUCKET=media
SUPABASE_API_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# ------------------------------------------------------------------------------
# Security: JWT Configuration (HS512 Key - minimum 64 characters)
# ------------------------------------------------------------------------------
JWT_SECRET=mySuperSecretKeyForDuralapAppWhichIsVerySecureAndLongEnoughForHS512
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
